// Paste these rows into ~/.config/omarchy/extensions/omarchy-menu.jsonc,
// inside its top-level { }. Omarchy reloads the file on save.
//
// "apps.microvm" puts MicroVMs under Apps in the Omarchy menu
// (Super+Alt+Space); search for vm, sandbox or microvm from anywhere in the
// menu. The menu searches `label` and `aliases` only.
{
  "apps.microvm": {
    "icon": "󰒋",
    "label": "MicroVMs",
    "description": "Start, stop, create, edit and delete NixOS MicroVMs · Super+Alt+V",
    "aliases": ["microvm", "vm", "sandbox", "virtual machine", "nixarchy vm"],
    "action": "omarchy-shell shell toggle nixarchy.microvm '{}'"
  }
}
